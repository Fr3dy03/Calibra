# CalibraGraph — environment template. Copy to .env and adjust.
# NEVER commit real private keys.

# --- database ---
DATABASE_URL=postgresql://calibragraph:calibragraph@localhost:5432/calibragraph

# --- redis / jobs ---
REDIS_URL=redis://localhost:6379
REMINDER_LAPSE_DAYS=30,14,7

# --- api ---
PORT=4000
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:3000

# --- object storage (MinIO in development) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=calibragraph-evidence
S3_ACCESS_KEY_ID=calibragraph
S3_SECRET_ACCESS_KEY=calibragraph-dev
S3_REGION=us-east-1

# --- BOT Chain (https://dev-docs.botchain.ai/docs/Developers/quick-guide/) ---
# mainnet chainId 677  rpc https://rpc.botchain.ai  explorer https://scan.botchain.ai/
# testnet chainId 968  rpc https://rpc.bohr.life     explorer https://scan.bohr.life/
CHAIN_ID=968
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
BOT_TESTNET_RPC_URL=https://rpc.bohr.life
REGISTRY_ADDRESS=

# Wallet key used by the API for registry writes (CALIBRATION_ISSUER role holder).
# Leave unset for deterministic simulation mode (development/tests).
REGISTRY_DEPLOYER_KEY=

# --- contracts deployment (Foundry) ---
DEPLOYER_PRIVATE_KEY=
LAB_ADMIN_ADDRESS=
INSTRUMENT_OWNER_ADDRESS=
BOTSCAN_API_KEY=

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
